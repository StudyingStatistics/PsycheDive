# ---------------------------------------------------------------------------
# PsycheDive configuration.
# Copy this file to ".env" and paste your own keys. Never commit ".env".
# This template intentionally contains NO real keys. Leave a value empty if you
# do not have that key: a made-up placeholder would be treated as a real key.
# The app runs fine with empty values too - it simply asks for the keys in
# the browser Settings panel instead.
# ---------------------------------------------------------------------------

# Groq: writes the explanations.  https://console.groq.com/keys
GROQ_API_KEY=

# Tavily: optional web search alongside Europe PMC and OpenAlex.
# https://app.tavily.com/home
TAVILY_API_KEY=

# Upstream endpoints (change only if you use a proxy)
GROQ_BASE=https://api.groq.com/openai/v1
TAVILY_BASE=https://api.tavily.com

# Model preference order, best first
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.6-27b,openai/gpt-oss-20b,llama-3.3-70b-versatile,llama-3.1-8b-instant

# Server
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

# Allow cross-origin calls. Keep 0 for normal use: the page is served by the same
# Flask server, so it does not need CORS, and 0 stops other websites in your
# browser from calling your local server (and spending your key).
# Set to 1 only if you serve the HTML page from somewhere else while developing.
CORS=0

# --- Public deployment (set PUBLIC_MODE=1 before putting this on the internet) ---
# In public mode the browser never stores or sends a key; only GROQ_API_KEY above is used.
PUBLIC_MODE=0
RATE_LIMIT_PER_MIN=40
MAX_TOKENS_CAP=8000
# Comma-separated origins allowed to call the API cross-origin (leave empty for same-origin only)
ALLOWED_ORIGINS=
